# Copy to .env for local use. On Render, set these in the dashboard.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=global@hollatap.com
SUPPORT_EMAIL=global@hollatap.com
COMPANY_NAME=Rhinowinks LLC
# WhatsApp number for the floating bubble, international format without +
WHATSAPP_NUMBER=2349047363235

# Database: leave empty to use a local SQLite file. On Render this is set automatically.
DATABASE_URL=

# Email (Zoho, organisation account): smtppro.zoho.com, port 465 (EU data centre: smtppro.zoho.eu), global@hollatap.com + an app-specific password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HollaTap <global@hollatap.com>

# Paystack: use test keys (sk_test_...) until launch, then live keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
