<%- include('../partials/header') %>
<section class="section"><div class="wrap">
  <h1 style="font-size:32px">Users</h1><%- include('_nav') %>
  <form method="get" class="btn-row" style="margin-bottom:12px"><input type="search" name="q" value="<%= q || '' %>" placeholder="Search email" style="max-width:320px" aria-label="Search email"><button class="btn small" type="submit">Search</button></form>
  <div class="table-wrap"><table class="data"><thead><tr><th>ID</th><th>Email</th><th>Plan</th><th>Industry</th><th>Affiliate</th><th>Credit</th><th>Joined</th></tr></thead><tbody>
  <% users.forEach(u => { %><tr><td><%= u.id %></td><td><%= u.email %></td><td><%= u.plan %><%= u.founding_member ? ' · founding' : '' %><%= u.team_id ? ' · team ' + u.team_id : '' %></td><td><%= u.industry || '' %></td><td><%= u.is_affiliate ? 'yes' : '' %></td><td><%= naira(u.credit_naira) %></td><td><%= new Date(u.created_at).toLocaleDateString('en-GB') %></td></tr><% }) %>
  </tbody></table></div>
</div></section>
<%- include('../partials/footer') %>
