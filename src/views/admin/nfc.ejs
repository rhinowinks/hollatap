<%- include('../partials/header') %>
<section class="section"><div class="wrap">
  <h1 style="font-size:32px">NFC cards</h1><%- include('_nav') %>
  <div class="grid c2" style="align-items:start">
    <form method="post" action="/admin/nfc/batch" class="card-box">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <h2 style="font-size:20px">Generate a batch for the factory</h2>
      <p class="small muted">Creates unique serials and links (<%= config.baseUrl %>/t/SERIAL) and downloads a CSV to send to the supplier: they program each chip with the URL and print the serial.</p>
      <div class="field"><label for="bq">How many</label><input id="bq" name="qty" type="number" min="1" max="10000" value="1000"></div>
      <div class="field"><label for="bn">Batch name</label><input id="bn" name="batch" type="text" maxlength="40" placeholder="B2026-12-TEST"></div>
      <button class="btn primary" type="submit">Generate and download CSV</button>
    </form>
    <div class="card-box"><h2 style="font-size:20px">Batches</h2>
      <% if (!batches.length) { %><p class="muted">None yet.</p><% } %>
      <% batches.forEach(b => { %><p><a href="/admin/nfc/batch/<%= encodeURIComponent(b.batch) %>.csv"><%= b.batch %></a> · <%= b.total %> cards · <%= b.claimed %> linked</p><% }) %>
    </div>
  </div>
  <h2 style="font-size:22px;margin-top:28px">Orders</h2>
  <div class="table-wrap"><table class="data"><thead><tr><th>Date</th><th>Customer</th><th>Qty</th><th>Type</th><th>Deliver to</th><th>Status</th></tr></thead><tbody>
  <% orders.forEach(o => { %><tr><td><%= new Date(o.created_at).toLocaleDateString('en-GB') %></td><td><%= o.email %><%= o.team_name ? ' · ' + o.team_name : '' %></td><td><%= o.quantity %></td><td><%= o.kind %></td><td class="small"><%= o.ship_name || '' %> <%= o.ship_phone || '' %><br><%= o.ship_address || '(waiting for address)' %></td>
  <td><form method="post" action="/admin/nfc/orders/<%= o.id %>" class="btn-row"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="status" aria-label="Status"><% ['new','dispatched','delivered'].forEach(s => { %><option <%= o.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn small" type="submit">Save</button></form></td></tr><% }) %>
  </tbody></table></div>
</div></section>
<%- include('../partials/footer') %>
