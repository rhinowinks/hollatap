<%- include('../partials/header') %>
<section class="section"><div class="wrap">
  <h1 style="font-size:32px">Payments</h1><%- include('_nav') %>
  <div class="table-wrap"><table class="data"><thead><tr><th>Date</th><th>Reference</th><th>User</th><th>Item</th><th>Amount</th><th>Credit</th><th>Discount</th><th>Status</th></tr></thead><tbody>
  <% payments.forEach(p => { %><tr><td><%= new Date(p.created_at).toLocaleString('en-GB') %></td><td class="tiny"><%= p.reference %></td><td><%= p.email %></td><td><%= JSON.parse(p.meta_json||'{}').label || p.kind %></td><td><%= naira(p.amount_naira) %></td><td><%= naira(p.credit_used) %></td><td><%= naira(p.discount_naira) %></td><td><%= p.status %></td></tr><% }) %>
  </tbody></table></div>
</div></section>
<%- include('../partials/footer') %>
