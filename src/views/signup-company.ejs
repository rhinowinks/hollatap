<%- include('partials/header') %>
<section class="section"><div class="narrow auth">
  <h1>Set up your company's cards</h1>
  <p class="muted">Create the admin login for your company. You'll log in with a username and password, and we'll also send a code to your email each time, so nobody else can get in.</p>
  <% if (error) { %><div class="flash error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/signup/company" class="card-box">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field"><label for="em">Your work email</label>
      <input id="em" name="email" type="email" required autocomplete="email" value="<%= email %>" placeholder="name@yourcompany.com" <%= loggedIn ? 'readonly' : '' %>>
      <span class="hint">Use your company email so staff and customers trust the verified badge.</span></div>
    <div class="field"><label for="un">Choose a username</label><input id="un" name="username" type="text" required minlength="3" maxlength="30" autocomplete="username" value="<%= username %>" placeholder="for example lekkilogistics"></div>
    <div class="field"><label for="pw">Choose a password</label><input id="pw" name="password" type="password" required minlength="8" autocomplete="new-password"><span class="hint">At least 8 characters, with a letter and a number.</span></div>
    <div class="field"><label for="pw2">Type the password again</label><input id="pw2" name="password2" type="password" required minlength="8" autocomplete="new-password"></div>
    <div class="field"><label class="check"><input type="checkbox" name="marketing_opt_in"> <span>Send me occasional tips and offers from HollaTap and Rhinowinks.</span></label></div>
    <%- include('partials/keep') %>
    <button class="btn primary big" type="submit">Email me a code</button>
    <p class="tiny muted" style="margin:12px 0 0">By continuing you agree to the <a href="/terms">terms</a> and <a href="/privacy">privacy notice</a>.</p>
  </form>
  <% if (!loggedIn) { %><p class="auth-switch">Already set up? <a href="/login/company">Company admin log in</a></p>
  <p class="auth-switch small">Just want a card for yourself? <a href="/signup">Sign up free</a></p><% } %>
</div></section>
<%- include('partials/footer') %>
