<%- include('partials/header') %>
<section class="auth-wrap"><div class="auth-grid"><%- include('partials/auth-side') %><div class="auth-main"><div class="auth">
  <h1>Check your email</h1>
  <p class="lead-code">We sent a 6-digit code to <b><%= email %></b>.</p>
  <% if (existed) { %><div class="flash success" role="status">You already have an account with this email, so this code will log you in.</div><% } %>
  <p class="muted small">It can take a minute to arrive. Look in spam or promotions if you can't see it. The code works for 15 minutes.</p>
  <% if (devHint) { %><div class="flash warn">Test mode: email isn't set up, so the code is printed in the server log.</div><% } %>
  <% if (error) { %><div class="flash error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/verify" class="card-box">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field"><label for="code">Type the 6 numbers</label><input id="code" class="code-input" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required autofocus></div>
    <button class="btn primary big" type="submit"><%= mode === 'reset' ? 'Continue' : mode === 'signup' ? 'Create my account' : 'Log in' %></button>
  </form>
  <form method="post" action="/verify/resend" style="margin-top:14px">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="btn" type="submit" style="width:100%">Send a new code</button>
  </form>
  <p class="auth-switch small"><a href="<%= mode.startsWith('company') ? '/login/company' : mode === 'signup' ? '/signup' : '/login' %>">Use a different email</a></p>
</div></div></div></section>
<%- include('partials/footer') %>
