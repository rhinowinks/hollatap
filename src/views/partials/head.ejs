<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof seoTitle !== 'undefined' ? seoTitle : title + ' | HollaTap' %></title>
<meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Free digital business cards with QR and NFC tap cards, made in Lagos. People tap or scan and your details save straight to their phone. No app needed.' %>">
<% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex"><% } %>
<link rel="icon" href="/brand/favicon.ico" sizes="any">
<link rel="icon" href="/brand/hollatap-favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/brand/app-icon-180.png">
<meta name="theme-color" content="#0F1B2D">
<% const _desc = typeof description !== 'undefined' ? description : 'Free digital business cards with QR and NFC tap cards, made in Lagos. People tap or scan and your details save straight to their phone. No app needed.'; %>
<% if (typeof canonical !== 'undefined' && canonical) { %><link rel="canonical" href="<%= config.baseUrl %><%= canonical %>"><meta property="og:url" content="<%= config.baseUrl %><%= canonical %>"><% } %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="HollaTap">
<meta property="og:locale" content="en_NG">
<meta property="og:title" content="<%= typeof seoTitle !== 'undefined' ? seoTitle : title %>">
<meta property="og:description" content="<%= _desc %>">
<meta name="twitter:card" content="summary_large_image">
<meta property="og:image" content="<%= config.baseUrl %>/brand/og-image-1200x630.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/app.css?v=<%= v %>">
<% if (typeof jsonld !== 'undefined' && jsonld) { %><script type="application/ld+json"><%- JSON.stringify(jsonld).replace(/</g, '\\u003c') %></script><% } %>
<% if (typeof marketing !== 'undefined' && marketing) { %><link rel="stylesheet" href="/css/site.css?v=<%= v %>"><% } %>
</head>
<body>
