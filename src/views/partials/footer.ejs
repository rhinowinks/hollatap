</main>
<%
  const _wa = config.whatsappNumber ? 'https://wa.me/' + config.whatsappNumber : null;
  let _band = typeof endBand !== 'undefined' ? endBand : null;
  if (_band !== false && !_band) {
    _band = user
      ? { title: 'Just holla.', text: 'Questions, or need a hand with your card? We reply fast on WhatsApp.', btns: [_wa ? { href: _wa, label: 'Chat on WhatsApp', cls: 'dark', ext: true } : { href: 'mailto:' + config.supportEmail, label: 'Email us', cls: 'dark' }, { href: '/dashboard', label: 'My cards', cls: 'clear' }] }
      : { title: 'Just holla.', text: 'Your free card is two minutes away.', btns: [{ href: '/signup', label: 'Make my free card', cls: 'dark' }, { href: '/for-teams', label: 'For companies', cls: 'clear' }] };
  }
%>
<% if (_band) { %>
<section class="end-band" style="background:#FF5A1F;color:#0F1B2D">
  <div class="wrap">
    <h2><%= _band.title %></h2>
    <p><%= _band.text %></p>
    <div class="btn-row"><% _band.btns.forEach(b => { %><a class="btn <%= b.cls %>" href="<%= b.href %>"<% if (b.ext) { %> target="_blank" rel="noopener"<% } %>><%= b.label %></a><% }) %></div>
  </div>
</section>
<% } %>
<footer class="site-footer">
  <div class="wrap">
    <div>
      <img src="/brand/hollatap-logo-horizontal-reversed.svg" alt="HollaTap" style="height:28px">
      <p style="margin-top:10px">Your business card, one tap away.<br>A Rhinowinks product.</p>
    </div>
    <div>
      <p><a href="/instant">Instant Card</a> · <a href="/upgrade">Pricing</a> · <a href="/for-teams">For companies</a> · <a href="/demo">Live demo</a> · <a href="/affiliates">Earn with us</a> · <a href="/login/company">Company admin log in</a></p>
      <p><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="mailto:<%= config.supportEmail %>"><%= config.supportEmail %></a></p>
      <p class="tiny">© <%= new Date().getFullYear() %> <%= config.company %></p>
    </div>
  </div>
</footer>
<% if (config.whatsappNumber) { %>
<a class="wa-bubble" href="https://wa.me/<%= config.whatsappNumber %>" target="_blank" rel="noopener" aria-label="Chat with HollaTap on WhatsApp">
  <svg viewBox="0 0 24 24" fill="none" stroke="#0F1B2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
</a>
<% } %>
</body>
</html>
