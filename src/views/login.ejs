<%- include('partials/header') %>
<section class="section"><div class="narrow" style="max-width:480px">
  <h1 style="font-size:32px">Sign in or create your account</h1>
  <p class="muted">We'll email you a 6-digit code. No password needed.</p>
  <% if (error) { %><div class="flash error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/login" class="card-box">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field"><label for="em">Email address</label><input id="em" name="email" type="email" required autocomplete="email" value="<%= email %>" placeholder="name@company.com"></div>
    <div class="field"><label for="ind">Your industry <span class="hint">(optional, helps us show relevant tips)</span></label>
      <select id="ind" name="industry"><option value="">Choose…</option><% industries.forEach(i => { %><option><%= i %></option><% }) %></select></div>
    <div class="field"><label class="check"><input type="checkbox" name="marketing_opt_in"> <span>Send me occasional tips and offers from HollaTap and Rhinowinks. Unsubscribe any time.</span></label></div>
    <button class="btn primary" type="submit" style="width:100%">Email me a code</button>
    <p class="tiny muted" style="margin-top:12px">By continuing you agree to the <a href="/terms">terms</a> and <a href="/privacy">privacy notice</a>.</p>
  </form>
</div></section>
<%- include('partials/footer') %>
