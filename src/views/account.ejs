<%- include('partials/header') %>
<section class="section"><div class="narrow">
  <h1 style="font-size:32px">Your account</h1>
  <form method="post" action="/account" class="card-box">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field"><label>Email</label><p style="margin:0"><%= user.email %></p></div>
    <div class="field"><label for="nm">Name</label><input id="nm" name="name" type="text" maxlength="120" value="<%= user.name || '' %>"></div>
    <div class="field"><label for="ind">Industry</label><select id="ind" name="industry"><option value="">Choose…</option><% industries.forEach(i => { %><option <%= user.industry === i ? 'selected' : '' %>><%= i %></option><% }) %></select></div>
    <div class="field"><label class="check"><input type="checkbox" name="marketing_opt_in" <%= user.marketing_opt_in ? 'checked' : '' %>> <span>Send me occasional tips and offers. Unsubscribe any time.</span></label></div>
    <button class="btn primary" type="submit">Save</button>
  </form>

  <h2 style="font-size:22px;margin-top:32px">Plan and payments</h2>
  <div class="card-box">
    <p>Current plan: <b><%= plan === 'pro' ? 'Pro' : plan === 'team' ? 'Teams' : 'Free' %></b><% if (user.plan_expires_at) { %>, paid until <%= new Date(user.plan_expires_at).toLocaleDateString('en-GB') %><% } %>.</p>
    <% if (payments.length) { %><div class="table-wrap"><table class="data"><thead><tr><th>Date</th><th>Item</th><th>Amount</th><th>Reference</th></tr></thead><tbody>
    <% payments.forEach(p => { %><tr><td><%= new Date(p.paid_at || p.created_at).toLocaleDateString('en-GB') %></td><td><%= JSON.parse(p.meta_json || '{}').label || p.kind %></td><td><%= naira(p.amount_naira) %></td><td class="tiny"><%= p.reference %></td></tr><% }) %>
    </tbody></table></div><% } else { %><p class="muted" style="margin:0">No payments yet.</p><% } %>
  </div>

  <h2 style="font-size:22px;margin-top:32px">Delete my data</h2>
  <form method="post" action="/account/delete" class="card-box" style="border-color:var(--danger)" data-confirm="Delete your account, all cards, logos and shared contacts permanently?">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <p>This permanently deletes your account, every card, your logos and the contacts people shared with you. It can't be undone. Payment records we must keep by law are kept without your details.</p>
    <div class="field"><label for="cf">Type DELETE to confirm</label><input id="cf" name="confirm" type="text" autocomplete="off"></div>
    <button class="btn danger" type="submit">Delete everything</button>
  </form>
</div></section>
<script src="/js/ui.js"></script>
<%- include('partials/footer') %>
